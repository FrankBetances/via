<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono adaptativo redondo de VIA+ (mismas capas: la máscara la pone el lanzador).

  El primer plano NO va a sangre: el lanzador solo garantiza el círculo central
  de 66 dp del lienzo de 108 dp, y el `ic_launcher_foreground.png` anterior
  medía 73 dp de dibujo, así que las barras de los extremos y el «+» se
  perdían con cualquier máscara. Los PNG los genera
  `scripts/build-launcher-icons.js` desde la geometría de ViaIcon.tsx, y
  `scripts/__tests__/launcherIcons.test.js` comprueba píxel a píxel que nada
  se sale de la zona segura.

  La capa monocroma es la que usa Android 13+ para los iconos temáticos: el
  sistema la tiñe con el color del tema y solo mira su alfa.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
