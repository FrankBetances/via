{
  "name": "via-plus",
  "version": "0.1.0",
  "private": true,
  "description": "VIA+ — Valoración Interactiva de Audición y Lenguaje (SaMD Clase IIa, MDR 2017/745)",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:clinical": "jest --testPathPattern=clinical",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:md": "npx --yes markdownlint-cli2@0.14.0 \"**/*.md\" \"!node_modules\"",
    "tsc": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/config": "^1.1.18",
    "@gluestack-ui/themed": "^1.1.34",
    "@hookform/resolvers": "^3.6.0",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/auth": "^25.1.0",
    "@react-native-firebase/firestore": "^25.1.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@reduxjs/toolkit": "^2.2.7",
    "buffer": "^6.0.3",
    "class-transformer": "^0.5.1",
    "expo": ">=54.0.0-0 <55.0.0",
    "expo-audio": "~1.1.1",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.3",
    "lucide-react-native": "^0.447.0",
    "lz-string": "^1.5.0",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-hook-form": "^7.52.1",
    "react-native": "0.81.5",
    "react-native-audio-api": "^0.8.4",
    "react-native-ble-plx": "^3.2.1",
    "react-native-gesture-handler": "^2.17.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-nitro-sqlite": "^9.6.0",
    "react-native-permissions": "^4.1.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "^3.15.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "4.24.0",
    "react-native-svg": "^15.6.0",
    "react-redux": "^9.1.2",
    "redux-persist": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/eslint-config": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@react-native/typescript-config": "0.81.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.5.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.1.0",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "preset": "react-native",
    "moduleNameMapper": {
      "\\.(m4a|mp3|wav|aac)$": "<rootDir>/jest/assetMock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|react-native-reanimated|react-native-svg|react-redux|@reduxjs|immer)/)"
    ],
    "setupFiles": [
      "<rootDir>/jest/setup.js"
    ]
  }
}
