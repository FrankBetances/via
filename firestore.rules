rules_version = '2';

// Reglas de Cloud Firestore para VIA+.
// Solo se sincroniza el perfil del profesional autenticado (professionals/{uid});
// los datos clínicos de pacientes son locales al dispositivo y NUNCA llegan aquí.
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada profesional solo puede leer y escribir su propio perfil,
    // anclado a su uid de Firebase Authentication.
    match /professionals/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Denegación explícita para todo lo demás.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
