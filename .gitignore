# ==========================================================================
# VIA+ — .gitignore (React Native 0.80 / TypeScript / Android + iOS)
# ==========================================================================

# --- OSX / OS ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# --- Xcode / iOS ---
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
.build/
*.xcuserstate
*.xccheckout
*.moved-aside
*.xcscmblueprint
xcuserdata/
**/xcuserdata/
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
DerivedData/
ios/.xcode.env.local
ios/build/

# ⚠️ NO ignorar `project.xcworkspace` entero.
#
# El .xcworkspace que Xcode crea DENTRO de un .xcodeproj no es un workspace
# de CocoaPods: guarda la resolución de Swift Package Manager, y dentro vive
# `xcshareddata/swiftpm/Package.resolved`, que SÍ debe versionarse para que
# todo el mundo compile contra las mismas versiones del SDK de Firebase.
# Ignorar la carpeta entera se lo lleva por delante sin que se note hasta que
# dos Macs compilan contra dependencias distintas.
# Del workspace solo sobra el estado por-usuario, ya cubierto arriba.

# --- Firma de iOS — la identidad de Apple NUNCA se versiona ---
**/Config/Signing.local.xcconfig
*.mobileprovision
*.p8
*.p12
*.cer
*.certSigningRequest

# --- Artefactos de distribución iOS ---
*.ipa
*.xcarchive
*.dSYM/
*.dSYM.zip
*.hmap

# --- CocoaPods ---
ios/Pods/
ios/Podfile.lock

# --- Ruby / Bundler / Fastlane ---
.bundle/
vendor/bundle/
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# --- Android / Gradle / IntelliJ ---
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/.cxx/
android/.kotlin/
android/app/.cxx/
*.iml
*.hprof
.idea/
.gradle/
local.properties

# --- Android signing — nunca commitear el keystore real ni sus credenciales ---
*.keystore
*.jks
!android/app/debug.keystore
android/keystore.properties

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- Metro / React Native ---
.metro-health-check*
*.jsbundle
.expo/

# --- Watchman ---
.watchmanconfig

# --- Testing / coverage ---
coverage/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Firebase — la configuración con API keys nunca debe versionarse ---
android/app/google-services.json
**/GoogleService-Info.plist
!android/app/google-services.json.example

# --- Sentry — el token de auth nunca debe subirse ---
.sentryclirc
.env.sentry-build-plugin

# --- TypeScript ---
*.tsbuildinfo

# --- VIA+ local SQLite DB artifacts ---
*.db
*.sqlite
*.sqlite3
*.db-journal

# --- Logs / temp ---
*.log
*.tmp
.cache/

# --- Editors ---
.vscode/
!.vscode/extensions.json
