+RCT_EXPORT_METHOD(isOnDeviceRecognitionAvailable:(NSString*)localeStr callback:(RCTResponseSenderBlock)callback) {
+    if (@available(iOS 13.0, *)) {
+        SFSpeechRecognizer* recognizer = nil;
+        if ([localeStr length] > 0) {
+            NSLocale* locale = [NSLocale localeWithLocaleIdentifier:localeStr];
+            recognizer = [[SFSpeechRecognizer alloc] initWithLocale:locale];
